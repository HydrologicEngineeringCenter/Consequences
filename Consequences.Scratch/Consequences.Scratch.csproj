<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Scratch paper. Never packed, never shipped, never referenced by anything real. -->
    <IsPackable>false</IsPackable>

    <!-- Experiments are allowed to be messy: unused variables and unreachable demo code
         are the point, not a defect. -->
    <NoWarn>$(NoWarn);CS0219;CS0162;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Consequences\Consequences.csproj" />
  </ItemGroup>

</Project>
